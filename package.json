{
  "name": "@chatwork/mcp-server",
  "version": "1.0.0",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "lint": "eslint && prettier --check .",
    "type-check": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "start:http": "node dist/index.js --transport http",
    "inspect": "npx -y @modelcontextprotocol/inspector --config ./inspector.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatwork/chatwork-mcp-server.git"
  },
  "keywords": [
    "kubell",
    "Chatwork",
    "MCP",
    "AI"
  ],
  "author": "kubell Co., LTD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chatwork/chatwork-mcp-server/issues"
  },
  "homepage": "https://github.com/chatwork/chatwork-mcp-server#readme",
  "description": "MCP (Model Context Protocol) server for operating Chatwork from AI",
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^5.0.1",
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0"
  }
}
